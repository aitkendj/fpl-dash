{
  "name": "fpl-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "test:transfers": "tsx scripts/test-transfers.ts",
    "test": "npm run validate && npm run test:transfers && npm run test:transform",
    "test:transform": "tsx scripts/test-transform.ts",
    "test:live": "tsx --conditions=react-server scripts/test-live.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
